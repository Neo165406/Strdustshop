{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/product.html",
      "has": [{ "type": "query", "key": "id" }],
      "destination": "/api/product"
    },
    { "source": "/product/:id/:slug", "destination": "/api/product?id=:id" },
    { "source": "/product/:id", "destination": "/api/product?id=:id" }
  ],
  "functions": {
    "api/product.js": {
      "includeFiles": "product.html"
    }
  }
}
